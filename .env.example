# SealAPI Lead Research Pipeline Configuration

# Server & Port Binding
FRONTEND_PORT=3000
BACKEND_PORT=8000
BACKEND_API_URL=http://127.0.0.1:8000
HOST_IP=127.0.0.1

# Persistent Storage Directory
DATA_DIR=/app/data

# Scrapling Web Extraction Settings
SCRAPER_TIMEOUT=10
SCRAPER_MAX_RETRIES=2
CONCURRENCY=3
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36 SealAPIResearchBot/1.0"
