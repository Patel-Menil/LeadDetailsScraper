# SealAPI Lead Research Pipeline Configuration

# Server & Port Binding
FRONTEND_PORT=3000
BACKEND_PORT=8000
BACKEND_API_URL=http://127.0.0.1:8000
HOST_IP=127.0.0.1

# Persistent Storage Directory
DATA_DIR=/app/data

# Environment (development or production)
APP_ENV=production

# Security & Authentication Secrets (Required in production)
# API_SECRET_KEY: Shared backend secret for FastAPI endpoints
API_SECRET_KEY=replace_with_secure_random_api_secret_key
# SESSION_SECRET: Secret for signing frontend HttpOnly session cookies (HMAC-SHA256)
SESSION_SECRET=replace_with_secure_random_session_secret
# AUTH_DISABLED: true skips the dashboard sign-in and backend API key checks.
# Only for a machine you run yourself; never set it on a shared or public server.
AUTH_DISABLED=false

# Scrapling Web Extraction Settings
SCRAPER_TIMEOUT=10
SCRAPER_MAX_RETRIES=2
CONCURRENCY=3
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36 SealAPIResearchBot/1.0"

# Company Intelligence (Company Details tab). All optional; no external API keys are required.
# Research reads only public pages on each company's official domain (direct, SSRF-checked, robots.txt honoured).
COMPANY_RESEARCH_MAX_PAGES=14
COMPANY_RESEARCH_MAX_PRODUCTS=4
COMPANY_RESEARCH_REQUEST_DELAY=1.0
COMPANY_RESEARCH_CONCURRENCY=2
# Optional JSON override of product-fit scoring weights, e.g. {"ai_evidence": 30, "api_evidence": 10}
COMPANY_FIT_WEIGHTS=
